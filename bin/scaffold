# Scaffold a new MSXDAW game repo.
#
#   scaffold <dest-dir> --name Game --mapper konami-scc [--rom path]
# Probe the ROM first (bin/probe). Pass --mapper / --banks from that report.
# 16/32 KiB unmapped carts: --mapper linear --banks 4 (or 2).
set -euo pipefail
DAW="$(cd "$(dirname "$0")/.." && pwd)"

dest=""
name=""
mapper=""
rom=""
banks=""
url_flag=""
banks_explicit=0
mapper_explicit=0
while [ $# -gt 0 ]; do
  case "$1" in
    --name) name="$2"; shift 2 ;;
    --mapper) mapper="$2"; mapper_explicit=1; shift 2 ;;
    --rom) rom="$2"; shift 2 ;;
    --banks) banks="$2"; banks_explicit=1; shift 2 ;;
    --url) url_flag="$2"; shift 2 ;;
    -*) echo "unknown flag $1" >&2; exit 2 ;;
    *) dest="$1"; shift ;;
  esac
done
[ -n "$dest" ] || { echo "usage: scaffold <dir> --name Game [--mapper linear|konami-scc|konami4|ascii8] [--banks N] [--rom file] [--url git-url]" >&2; exit 2; }
[ -n "$name" ] || name="$(basename "$dest")"

if [ -n "$rom" ] && [ -f "$rom" ] && [ "$banks_explicit" -eq 0 ]; then
  sz=$(wc -c < "$rom" | tr -d ' ')
  banks=$((sz / 8192))
  [ "$banks" -gt 0 ] || banks=1
fi
[ -n "$banks" ] || banks=16
if [ "$mapper_explicit" -eq 0 ]; then
  if [ "$banks" -le 4 ]; then
    mapper="linear"
  else
    mapper="konami4"
  fi
fi
[ -n "$mapper" ] || mapper="konami4"

mkdir -p "$dest"
dest="$(cd "$dest" && pwd)"

if [ ! -d "$dest/.git" ]; then
  git -C "$dest" init -q
fi

# Submodule: --url wins; else relative if dest is a sibling of a standalone
# DAW clone; else GitHub (never a nested tools/workbench working copy).
daw_parent="$(cd "$DAW/.." && pwd)"
dest_parent="$(cd "$dest/.." && pwd)"
if [ -n "$url_flag" ]; then
  url="$url_flag"
elif [ "$daw_parent" = "$dest_parent" ]; then
  url="../$(basename "$DAW")"
else
  url="git@github.com:0xe1f/MSXDAW.git"
fi
mkdir -p "$dest/tools"
if [ ! -e "$dest/tools/workbench" ]; then
  git -C "$dest" submodule add -q "$url" tools/workbench
fi

mkdir -p "$dest/banks" "$dest/docs" "$dest/.agents/skills" "$dest/generated"
touch "$dest/.agents/skills/.gitkeep"

orgs=""
i=0
while [ "$i" -lt "$banks" ]; do
  case $((i % 4)) in
    0) o=4000 ;;
    1) o=6000 ;;
    2) o=8000 ;;
    3) o=A000 ;;
  esac
  if [ -n "$orgs" ]; then orgs="${orgs},"; fi
  orgs="${orgs}${o}"
  i=$((i + 1))
done
scan=""
i=0
while [ "$i" -lt "$banks" ] && [ "$i" -lt 4 ]; do
  if [ -n "$scan" ]; then scan="${scan},"; fi
  scan="${scan}${i}"
  i=$((i + 1))
done

cat > "$dest/workbench.cfg" <<EOF
name = ${name}
master = ${name}.asm
rom = ${name}.rom
mapper = ${mapper}
banks = ${banks}
bank_size = 8192
source_dir = banks
bank_prefix = bank
sym = banks/msx.sym
scan_banks = ${scan}
bank_org = ${orgs}
EOF

cp "$DAW/scaffold/bios.inc" "$dest/banks/bios.inc"
cp "$DAW/scaffold/ram.inc" "$dest/banks/ram.inc"
: > "$dest/banks/msx.sym"

sha1="(run probe / shasum after providing the ROM)"
if [ -n "$rom" ] && [ -f "$rom" ]; then
  cp "$rom" "$dest/${name}.rom"
  sha1="$(shasum -a 1 "$dest/${name}.rom" | awk '{print $1}')"
  printf '%s  %s.rom\n' "$sha1" "$name" > "$dest/${name}.sha1"
  # extract leftover bins
  python3 -c "
from pathlib import Path
rom = Path('${dest}/${name}.rom').read_bytes()
n = ${banks}
dest = Path('${dest}/banks')
for i in range(n):
    dest.joinpath(f'bank{i:02d}.bin').write_bytes(rom[i*8192:(i+1)*8192])
print('extracted', n, 'banks')
"
fi

{
  echo "; ==========================================================================="
  echo ";  ${name}  —  MSXDAW scaffold. Mapper: ${mapper}, ${banks} x 8 KiB banks."
  echo ";  One INCBIN per bank until a bank is folded into banks/bankNN.asm."
  echo "; ==========================================================================="
  echo
  echo "    OUTPUT \"${name}.rom\""
  echo "    ORG 0x0000"
  echo
  echo "    INCLUDE \"banks/bios.inc\""
  echo "    INCLUDE \"banks/ram.inc\""
  echo
  i=0
  while [ "$i" -lt "$banks" ]; do
    nn=$(printf "%02d" "$i")
    page=$((i % 4))
    case $page in
      0) org=0x4000 ;;
      1) org=0x6000 ;;
      2) org=0x8000 ;;
      3) org=0xA000 ;;
    esac
    echo "; --- bank ${nn} ---"
    echo "    PHASE ${org}"
    if [ -f "$dest/banks/bank${nn}.bin" ]; then
      echo "    INCBIN \"banks/bank${nn}.bin\""
    else
      echo "    ; INCBIN \"banks/bank${nn}.bin\"   ; add ROM and re-run split-rom"
      echo "    ds 8192, 0"
    fi
    echo "    DEPHASE"
    echo
    i=$((i + 1))
  done
} > "$dest/${name}.asm"

cp "$DAW/scaffold/Makefile" "$dest/Makefile"
cp "$DAW/scaffold/gitignore" "$dest/.gitignore"
cp "$DAW/scaffold/AGENTS.md" "$dest/AGENTS.md"
mkdir -p "$dest/.github/workflows"
cp "$DAW/scaffold/github/workflows/verify.yml" "$dest/.github/workflows/verify.yml"
sed -i '' "s/__GAME__/${name}/g" "$dest/Makefile" "$dest/AGENTS.md" "$dest/.gitignore" \
  "$dest/.github/workflows/verify.yml"
if [ -f "$DAW/LICENSE" ]; then
  cp "$DAW/LICENSE" "$dest/LICENSE"
fi
cat > "$dest/NOTICE" <<EOF
${name} (MSX) disassembly
Copyright 2026 Akop Karapetyan

Licensed under the Apache License, Version 2.0. See LICENSE.

This Apache license covers original work in this repository: tools,
comments, documentation, labels, and project structure.

The original game ROM, graphics, music, and sound are not relicensed.
EOF

badge=""
origin="$(git -C "$dest" remote get-url origin 2>/dev/null || true)"
if [ -n "$origin" ]; then
  slug="${origin%.git}"
  slug="${slug%/}"
  case "$slug" in
    git@github.com:*) slug="${slug#git@github.com:}" ;;
    https://github.com/*) slug="${slug#https://github.com/}" ;;
    http://github.com/*) slug="${slug#http://github.com/}" ;;
    ssh://git@github.com/*) slug="${slug#ssh://git@github.com/}" ;;
    *) slug="" ;;
  esac
  if [ -n "$slug" ]; then
    actions="https://github.com/${slug}/actions/workflows/verify.yml"
    ep="https://img.shields.io/endpoint?style=flat&url=https://raw.githubusercontent.com/${slug}/badges"
    badge="[![verify](${actions}/badge.svg)](${actions})
[![in source](${ep}/in-source.json)](${actions})
[![named](${ep}/named.json)](${actions})
[![comments](${ep}/commented.json)](${actions})
[![subs](${ep}/subs.json)](${actions})
"
  fi
fi
cat > "$dest/README.md" <<EOF
# ${name} (MSX) — disassembly
${badge}
A work-in-progress, **byte-exact and reassemblable** disassembly.

\`\`\`sh
make verify     # assemble, then SHA-1 check against ${name}.sha1
make coverage   # local Shields JSON under generated/badges/
\`\`\`

Need **sjasmplus** at \`tools/sjasmplus\` (\`tools/workbench/bin/install-sjasmplus\`).
ROM dump is gitignored; the SHA-1 is committed. Workbench: \`tools/workbench\`
(MSXDAW submodule).

See \`docs/game-notes.md\` and \`docs/progress.md\`.
EOF

cat > "$dest/docs/progress.md" <<EOF
# ${name} — progress

Scaffolded by MSXDAW. Next: provide the ROM (gitignored), \`make verify\`,
\`tools/workbench/bin/probe\`, regen bank 0 into \`banks/bank00.asm\`.

Do not invent paging-window files until this cart's mapper schedule is known.
EOF

cat > "$dest/docs/game-notes.md" <<EOF
# ${name} — notes

Mapper: ${mapper}. See \`docs/probe.md\` after running probe.
EOF

( cd "$dest" && "$DAW/bin/install-skills" )

echo "scaffolded $dest ($name, mapper=$mapper)"
