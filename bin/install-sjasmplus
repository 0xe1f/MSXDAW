# Clone, build, and install sjasmplus into this game repo's tools/sjasmplus
# (gitignored). Pin matches CI: z00m128/sjasmplus v1.24.0 with submodules.
#
#   install-sjasmplus         # skip if tools/sjasmplus already exists
#   install-sjasmplus --force
set -euo pipefail
DAW="$(cd "$(dirname "$0")/.." && pwd)"
TAG="${SJASMPLUS_TAG:-v1.24.0}"
SRC_URL="https://github.com/z00m128/sjasmplus.git"
force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --force|-f) force=1; shift ;;
    -*) echo "usage: install-sjasmplus [--force]" >&2; exit 2 ;;
    *) echo "usage: install-sjasmplus [--force]" >&2; exit 2 ;;
  esac
done

project_root() {
  local d="$PWD"
  while [ "$d" != "/" ]; do
    if [ -f "$d/workbench.cfg" ]; then
      printf '%s\n' "$d"
      return
    fi
    d="$(dirname "$d")"
  done
  if [ "$(basename "$DAW")" = "workbench" ] \
     && [ "$(basename "$(dirname "$DAW")")" = "tools" ] \
     && [ -f "$DAW/../../workbench.cfg" ]; then
    (cd "$DAW/../.." && pwd)
    return
  fi
  return 1
}

root="$(project_root)" || {
  echo "install-sjasmplus: run from a game repo (workbench.cfg)" >&2
  exit 1
}
dest="$root/tools/sjasmplus"
if [ "$force" -eq 0 ] && [ -x "$dest" ]; then
  echo "already installed: $dest ($("$dest" --version 2>&1 | head -1))"
  exit 0
fi

command -v git >/dev/null && command -v make >/dev/null && command -v c++ >/dev/null || {
  echo "install-sjasmplus: need git, make, and a C++ compiler" >&2
  exit 1
}

tmp="$(mktemp -d "${TMPDIR:-/tmp}/sjasmplus.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
git clone --recursive --branch "$TAG" "$SRC_URL" "$tmp/src"
make -C "$tmp/src"
mkdir -p "$root/tools"
cp "$tmp/src/sjasmplus" "$dest"
echo "installed $dest ($("$dest" --version 2>&1 | head -1))"
